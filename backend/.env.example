# LOCAL DEVELOPMENT TEMPLATE ONLY. Do not deploy this file unchanged.
# Production requires DEBUG=false, MySQL/TiDB, explicit origins, and Secure cookies.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8443
CORS_ALLOWED_ORIGINS=http://localhost:8443

# Local development defaults to SQLite. Use DB_ENGINE=mysql for TiDB/MySQL.
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=4000
DB_SSL=true
DB_SSL_CA=

# Production must set these to true behind HTTPS. Keep SameSite=Lax for local development; use SameSite=None for separate HTTPS frontend/backend origins.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax


# Production security (enable HTTPS redirect only when HTTPS is configured at the proxy).
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SECURE_PROXY_SSL_HEADER_ENABLED=false
LOG_DIR=
LOG_LEVEL=INFO

# Optional: share login/register rate-limit counters between Gunicorn workers via the database.
# Leave empty locally. In production set a table name (e.g. mettamart_cache) and run
# `python manage.py createcachetable` once before starting the app.
CACHE_DB_TABLE=

# Optional order safety policy defaults: max active orders/account=5, auto-cancel=0 (disabled).
